# Cheie API Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Parola comuna partajata colegilor pentru acces in aplicatie
APP_PASSWORD=

# String random lung (min. 32 caractere), folosit pentru semnarea cookie-ului de sesiune.
# Genereaza unul cu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Injectat automat de Vercel cand atasezi storage-ul Postgres in dashboard - nu completa manual in productie.
POSTGRES_URL=
